# Create a dedicated reaction config (conf file with stream and filter)
#
# usage: ynh_config_add_fail2ban --logpath=log_file --failregex=filter
# | arg: --logpath=   - Log file to be checked by reaction
# | arg: --failregex= - Failregex to be looked for by reaction
#
# If --logpath / --failregex are provided, the helper will generate the appropriate conf using these.
#
# Otherwise, it will assume that the app provides a template named `../conf/reaction_filter.jsonnet`
#
# It will typically look like (for example here for a php app):
#
# ```jsonnet
# local ban = import '_ban.jsonnet';
# {
#   streams: {
#     '__APP__': {
#       cmd: ['tail', '-Fn0', '/var/log/nginx/__DOMAIN__-error.log'],
#       filters: {
#         'authfail': {
#           regex: [ @'auth\.php.*failed login attempt.*from IP <HOST>$' ]
#           retry: 5,
#           retryperiod: '5h',
#           actions: ban('1h'),
#         },
#       },
#     },
#   },
# }
# ```
#
# ##### Regarding the the `failregex` option
#
# regex to match the password failure messages in the logfile. The host must be
# matched by a group named "`host`". The pattern "`<HOST>`" can be used for standard
# IP matching and will match both IPv4 and IPv6 addresses.
#
# You can find some more explainations about how to make a regex on [the official reaction documentation](https://reaction.ppom.me/get-started/tutorial-en/#retrieving-logs).
#
# To validate your regex you can test with this command:
#
# ```bash
# cat /var/log/YOUR_LOG_FILE_PATH | reaction test-regex -c /etc/reaction/ 'YOUR_REGEX'
# ```

conf_path="/etc/reaction/app-$app.jsonnet"

ynh_config_add_fail2ban() {
    # ============ Argument parsing =============
    local -A args_array=([l]=logpath= [r]=failregex=)
    local logpath
    local failregex
    ynh_handle_getopts_args "$@"
    # ===========================================

    # Test that reaction is running
    systemctl is-active --quiet reaction.service && local reaction_running=1

    # If failregex is provided, Build a config file on-the-fly using $logpath and $failregex
    if test -n "${failregex:-}"
    then
        test -n "$logpath" || ynh_die "ynh_config_add_fail2ban expects a logfile path as first argument and received nothing."

        local streamname="$(tr '.' '_' <<< "$logpath")"

        echo "
local ban = import '_ban.jsonnet';
{
  streams: {
    '$streamname': {
      cmd: ['tail', '-Fn0', '$logpath'],
      filters: {
        '$app': {
          regex: [ @'$failregex' ],
          retry: 5,
          retryperiod: '5h',
          actions: ban('1h'),
        },
      },
    },
  },
}
" > "$YNH_APP_BASEDIR/conf/reaction_filter.jsonnet"
    fi

    ynh_config_add --template="reaction_filter.jsonnet" --destination="$conf_path"

    if ! reaction test-config -c /etc/reaction; then
      ynh_print_warn "reaction failed to load the configuration for $app"
      mv "$conf_path" "$conf_path.failed"

    else

      ynh_systemctl --service=reaction --action=restart --wait_until="(Started|Restarted) reaction.service" --log_path=systemd

      # Test if reaction failed (and that it was running in the first place)
      systemctl --failed | grep -q reaction.service
      if test $? -eq 0 && test -n "$reaction_running"
      then
          # Log the error
          local reaction_error="$(journalctl --no-hostname --unit=reaction.service --lines=50 | grep "ERROR.*$app.*")"
          ynh_print_warn "reaction failed to load the configuration for $app"
          ynh_print_warn "${reaction_error#*WARNING}"

          # Suffix the app's reaction conf and restart reaction
          mv "$conf_path" "$conf_path.failed"
          ynh_systemctl --service=reaction --action=restart --wait_until="(Started|Restarted) reaction.service" --log_path=systemd
      fi
    fi
}

# Remove the dedicated reaction config (jail and filter conf files)
#
# usage: ynh_config_remove_reaction
ynh_config_remove_fail2ban() {
    ynh_safe_rm "$conf_path"
    ynh_systemctl --service=reaction --action=restart
}
