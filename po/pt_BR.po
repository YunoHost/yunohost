msgstr ""
"DNS reverso atual: <code>{rdns_domain}</code><br>Valor esperado: "
"<code>{ehlo_domain}</code>"

#: src/diagnosers/24-mail.py:199
msgid "diagnosis_mail_fcrdns_different_from_ehlo_domain"
msgstr ""
"O DNS reverso não está configurado corretamente para o endereço "
