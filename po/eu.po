#: src/diagnosers/24-mail.py:89
msgid "diagnosis_mail_outgoing_port_25_blocked"
msgstr ""
"SMTP posta zerbitzariak ezin ditu posta elektronikoak bidali 25. ataka "
"itxita dagoelako IPv{ipversion}n."

#: src/diagnosers/24-mail.py:91
msgid "diagnosis_mail_outgoing_port_25_blocked_details"
msgstr ""
"Lehenik eta behin operadorearen routerreko aukeretan saiatu beharko "
"zinateke 25. ataka desblokeatzen. (Hosting enpresaren arabera, beraiekin "
"harremanetan jartzea beharrezkoa izango da)."

#: src/diagnosers/24-mail.py:92
msgid "diagnosis_mail_outgoing_port_25_blocked_relay_vpn"
msgstr ""
"Operadore batzuei bost axola zaie Interneten neutraltasuna (Net "
"Neutrality) eta ez dute 25. ataka desblokeatzen uzten.<br>- Operadore "
"batzuek <a href='https://doc.yunohost.org/email_configure_relay'>relay "
"posta zerbitzari bat</a> eskaini dezakete, baina kasu horretan zure posta"
" elektronikoa zelatatu dezakete.<br>- Pribatutasuna bermatzeko *IP "
"publikoa* duen VPN bat erabiltzea izan daiteke irtenbidea. Ikus <a "
"href='https://doc.yunohost.org/vpn_advantage'>https://doc.yunohost.org/vpn_advantage</a><br>-"
" Edo <a href='https://doc.yunohost.org/providers/isp'>operadore desberdin"
" batera aldatu</a>"

#: src/diagnosers/24-mail.py:116
msgid "diagnosis_mail_ehlo_could_not_diagnose"
msgstr ""
"Ezinezkoa izan da postfix posta zerbitzaria IPv{ipversion}az kanpo "
"eskuragarri dagoen egiaztatzea."

#: src/diagnosers/24-mail.py:117
msgid "diagnosis_mail_ehlo_could_not_diagnose_details"
msgstr "Errorea: {error}"

#: src/diagnosers/24-mail.py:139
msgid "diagnosis_mail_ehlo_wrong"
msgstr ""
"Zurea ez den SMTP posta zerbitzari batek erantzun du IPv{ipversion}an. "
"Litekeena da zure zerbitzariak posta elektronikorik jaso ezin izatea."

#: src/diagnosers/24-mail.py:140
msgid "diagnosis_mail_ehlo_wrong_details"
msgstr ""
"Kanpo-diagnostikatzaileak IPv{ipversion}an jaso duen EHLOa eta zure "
"zerbitzariaren domeinukoa ez datoz bat.<br> Jasotako EHLOa: "
"<code>{wrong_ehlo}</code><br>Esperotakoa: "
"<code>{right_ehlo}</code><br>Arazo honen zergati ohikoena 25. ataka <a "
"href='https://doc.yunohost.org/admin/get_started/post_install/dns_config/'>zuzen"
" konfiguratuta ez egotea</a> da. Edo agian suebaki edo reverse-proxya "
"oztopo izan daiteke."

#: src/diagnosers/24-mail.py:154 src/diagnosers/24-mail.py:160
msgid "diagnosis_mail_fcrdns_nok_details"
msgstr ""
"Lehenik eta behin zure routerraren konfigurazio gunean edo hostingaren "
"enpresaren aukeretan alderantzizko DNSa konfiguratzen saiatu beharko "
"zinateke <code>{ehlo_domain}</code> erabiliz. (Hosting enpresaren "
"arabera, ezinbestekoa da beraiekin harremanetan jartzea)."

#: src/diagnosers/24-mail.py:155
msgid "diagnosis_mail_fcrdns_nok_alternatives_6"
msgstr ""
"Operadore batzuek ez dute alderantzizko DNSa konfiguratzen uzten (edo "
"funtzioa ez dabil…). IPv4rako alderantzizko DNSa zuzen konfiguratuta "
"badago, IPv6 desgaitzen saia zaitezke posta elektronikoa bidaltzeko, "
"<cmd>yunohost settings set email.smtp.smtp_allow_ipv6 -v off</cmd> "
"exekutatuz. Adi: honek esan nahi du ez zarela gai izango IPv6 bakarrik "
"darabilten zerbitzari apurren posta elektronikoa jasotzeko edo beraiei "
"bidaltzeko."

#: src/diagnosers/24-mail.py:161
msgid "diagnosis_mail_fcrdns_nok_alternatives_4"
msgstr ""
"Operadore batzuek ez dute alderantzizko DNSa konfiguratzen uzten (edo "
"funtzioa ez dabil…). Hori dela eta, arazoak badituzu, irtenbide batzuk "
"eduki ditzakezu:<br>- Operadore batzuek <a "
"href='https://doc.yunohost.org/email_configure_relay'>relay posta "
"zerbitzari bat</a> eskaini dezakete, baina kasu horretan zure posta "
"elektronikoa zelatatu dezakete.<br>- Pribatutasuna bermatzeko *IP "
"publikoa* duen VPN bat erabiltzea izan daiteke irtenbidea. Ikus <a "
"href='https://doc.yunohost.org/vpn_advantage'>https://doc.yunohost.org/vpn_advantage</a><br>-"
" Edo <a href='https://doc.yunohost.org/providers/isp'>operadore desberdin"
" batera aldatu</a>"

#: src/diagnosers/24-mail.py:179
msgid "diagnosis_mail_fcrdns_dns_missing"
msgstr ""
"Ez da alderantzizko DNSrik ezarri IPv{ipversion}rako. Litekeena da "
"hartzaileak posta elektroniko batzuk jaso ezin izatea edo mezuok spam "
"gisa etiketatuak izatea."

#: src/diagnosers/24-mail.py:189
msgid "diagnosis_mail_fcrdns_different_from_ehlo_domain_details"
msgstr ""
"Oraingo alderantzizko DNSa: <code>{rdns_domain}</code><br>Esperotako "
"balioa: <code>{ehlo_domain}</code>"

#: src/diagnosers/24-mail.py:199
msgid "diagnosis_mail_fcrdns_different_from_ehlo_domain"
msgstr ""
"Alderantzizko DNSa ez dago zuzen konfiguratuta IPv{ipversion}an. "
"Litekeena da hartzaileak posta elektroniko batzuk jaso ezin izatea edo "
"mezuok spam gisa etiketatuak izatea."

#: src/diagnosers/24-mail.py:243
msgid "diagnosis_mail_blocklist_reason"
msgstr "Zerrenda beltzean egotearen zergatia zera da: {reason}"

#: src/diagnosers/24-mail.py:245
msgid "diagnosis_mail_blocklist_reason_openresolver"
msgstr ""
"Badirudi 'open resolver'i egiten diola aipamena.<br/>Honek esan nahi du, "
"normalean, zure zerbitzaria ez dela bere DNS lokala erabiltzen ari, "
"baizik eta publiko, ireki bat.<br/>Berrikusi "
"<code>/etc/resolv.conf</code> fitxategiko edukia, <code>nameserver "
"127.0.0.1</code> izan beharko luke bere baitan.<br/>Fitxategia "
"automatikoki sortzen denez, ez ezazu eskuz editatu. Egiaztatu zure DHCP "
"ezarpenak (edo zure VPN ezarpenak halakorik erabiliz gero), edo, VPS "
"hornitzaile batek egindako Debian irudi bat erabili baduzu, bilatu "
"<code>cloudinit</code> konfigurazioa.<br/>YunoHost laguntza-kanaletan "
"ongi etorria zara gai honi buruzko laguntza lortzeko.<br/>Zerrenda "
"beltzaren arrazoia honakoa da: {reason}"

#: src/diagnosers/24-mail.py:248
msgid "diagnosis_mail_blocklist_website"
msgstr ""
"Zerrenda beltzean zergatik zauden ulertu eta konpondu ondoren, "
"{blocklist_website} webgunean zure IP edo domeinua bertatik atera "
