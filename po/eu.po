#: src/diagnosers/21-web.py:51
msgid "diagnosis_http_nginx_conf_not_up_to_date_details"
msgstr ""
"Egoera konpontzeko, ikuskatu desberdintasunak <cmd> yunohost tools regen-"
"conf nginx --dry-run --with-diff</cmd> komandoaren bidez eta, "
"proposatutako aldaketak onartzen badituzu, ezarri itzazu <cmd>yunohost "
"tools regen-conf nginx --force</cmd> erabiliz."

#: src/diagnosers/21-web.py:57
