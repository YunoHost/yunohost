msgstr "Rework the way app permissions are stored"

#: src/migrations/m0034_fix_missing_admins_aliases.py
msgid "migration_description_0034_fix_missing_admins_aliases"
msgstr "Fix missing mail aliases for the admins group"

#: src/migrations/m0035_fix_apps_nodejs_version.py
msgid "migration_description_0035_fix_apps_nodejs_version"
msgstr "Fix nodejs versions in app systemd configurations"

#: src/migrations/m0031_terms_of_services.py
msgid "migration_description_0031_terms_of_services"
msgstr "Terms of services"

