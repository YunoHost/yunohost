msgstr "Force HTTPS"

#: share/config_global.toml
msgid "global_settings_setting_nginx_redirect_to_https_help"
msgstr ""
"Redirect HTTP requests to HTTPs by default (DO NOT TURN OFF unless you "
"really know what you're doing!)"

#: share/config_global.toml
msgid "global_settings_setting_nginx_compatibility"
msgstr "NGINX Compatibility"

#: share/config_global.toml
msgid "global_settings_setting_nginx_compatibility_help"
msgstr ""
"Compatibility vs. security tradeoff for the web server NGINX. Affects the"
" ciphers (and other security-related aspects)"

#: share/config_global.toml
