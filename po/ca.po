#: src/diagnosers/14-ports.py:108 src/diagnosers/14-ports.py:143
#: src/diagnosers/14-ports.py:170
msgid "diagnosis_ports_forwarding_tip"
msgstr ""
"Per arreglar aquest problema, segurament s'ha de configurar el "
"reenviament de ports en el router tal i com s'explica a <a "
"href='https://doc.yunohost.org/admin/get_started/post_install/dns_config/'>https://doc.yunohost.org/admin/get_started/post_install/dns_config/</a>"

#: src/diagnosers/14-ports.py:140 src/diagnosers/14-ports.py:167
