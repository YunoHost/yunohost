"autorisée."

#: share/config_global.toml
msgid "global_settings_setting_portal_name"
msgstr "Portail"

#: share/config_global.toml
msgid "global_settings_setting_portal_allow_edit_email"
msgstr "Autoriser les utilisateur·ice·s à modifier leur adresse mail principale"

#: share/config_global.toml
msgid "global_settings_setting_portal_allow_edit_email_help"
msgstr ""
"Si désactivé, les personnes souhaitant changer leur adresse mail devront "
"demander aux administrateur·ice·s."

#: share/config_global.toml
