msgstr ""
"Le domaine {domain} est basé sur un domaine de premier niveau (TLD) à "
"usage spécial comme .local ou .test et ne devrait donc pas avoir "
"d'enregistrements DNS réels."

#: src/diagnosers/12-dnsrecords.py:133
msgid "diagnosis_dns_missing_record"
msgstr ""
"Selon la configuration DNS recommandée, vous devez ajouter un "
"enregistrement DNS<br>Type : <code>{type}</code><br>Nom : "
"<code>{name}</code><br>Valeur : <code>{content}</code>"

