msgstr "Berkas konfigurasi <code>{file}</code> sepertinya telah diubah manual."

#: src/diagnosers/70-regenconf.py:53
msgid "diagnosis_regenconf_manually_modified_details"
msgstr ""
"Ini mungkin OK jika Anda tahu apa yang Anda lakukan! YunoHost akan "
