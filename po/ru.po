msgid "diagnosis_basesystem_kernel"
msgstr "Версия ядра Linux на сервере {kernel_version}"

#: src/diagnosers/00-basesystem.py:96
msgid "diagnosis_basesystem_host"
msgstr "На сервере запущен Debian {debian_version}"

