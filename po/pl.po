msgstr "Może być to że zamiast twojego serwera odbiera inny komputer."

#: src/diagnosers/24-mail.py:124
msgid "diagnosis_mail_ehlo_unreachable"
msgstr ""
"Serwer poczty SMTP jest niedostępny z zewnątrz przez IPv{ipversion}. Nie "
