msgstr "Xestiona as interaccións entre a interface web de YunoHost e o sistema"

#: conf/yunohost/services.yml
msgid "service_description_nftables"
msgstr "Xestiona, abre e pecha a conexións dos portos aos servizos"

#: conf/yunohost/services.yml
